{
  "name": "calendar-slots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typespec/compiler": "^1.16.0",
    "@typespec/http": "^1.16.0",
    "@typespec/openapi": "^1.16.0",
    "@typespec/openapi3": "^1.16.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "generate": "tsp compile spec && openapi-typescript spec/generated/openapi.yaml -o server/src/generated/api.ts && openapi-ts",
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint . && prettier --check \"server/src/**/*.ts\" \"server/test/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" --ignore-path .prettierignore",
    "format": "prettier --write \"server/src/**/*.ts\" \"server/test/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" --ignore-path .prettierignore",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  }
}
